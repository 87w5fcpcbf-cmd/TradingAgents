# ============================================================================
# Agentic Trader — secrets template.  Copy to .env and fill in.
#   cp .env.example .env && $EDITOR .env
# NEVER commit .env. Load via python-dotenv or your shell. No keys are hardcoded.
# ============================================================================

# ---- LLM provider (the agent brain) ----
# Match config.yaml -> llm.deep_model / shallow_model to whatever you set here.
ANTHROPIC_API_KEY=          # for Claude (config.llm.deep_model: "claude")
# OPENAI_API_KEY=           # for GPT / Codex
# GOOGLE_API_KEY=           # for Gemini

# ---- Market data (paper mode quotes + analyst tools) ----
# yfinance needs no key. Set these only if you wire a paid feed / Alpha Vantage.
# ALPHA_VANTAGE_API_KEY=
# FRED_API_KEY=

# ---- Robinhood Agentic Trading MCP (LIVE mode only) ----
# Create the dedicated Agentic account in the Robinhood app, fund the isolated
# wallet with risk capital only, then get the MCP URL + auth from their
# agentic-trading docs. LEAVE BLANK while running in paper mode.
ROBINHOOD_MCP_URL=          # e.g. https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN=        # OAuth/bearer token from Robinhood's auth flow
